{
  "name": "causal-ai-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "因果AI 前端静态资源本地化构建（Tailwind 预编译 + 第三方库版本锁定）",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i static/css/tailwind.src.css -o static/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i static/css/tailwind.src.css -o static/css/tailwind.min.css --watch",
    "fonts": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/localize_fonts.ps1",
    "check:assets": "node tools/check_local_assets.js",
    "check:libs": "node tools/check_umd_libs.js",
    "check:katex": "node tools/check_marked_katex.js",
    "check:tailwind": "node tools/check_tailwind_coverage.js",
    "check": "npm run check:assets && npm run check:libs && npm run check:katex && npm run check:tailwind"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.0.0",
    "@fontsource/orbitron": "5.0.0",
    "@tweenjs/tween.js": "18.6.4",
    "easymde": "2.18.0",
    "katex": "0.16.21",
    "marked": "4.3.0",
    "marked-katex-extension": "5.1.13",
    "socket.io-client": "4.5.4",
    "three": "0.128.0",
    "vis-network": "9.1.9"
  }
}
